# ==============================================================================
# MIAUTO - Приклад конфігурації змінних середовища (.env)
# ==============================================================================
# Скопіюйте цей файл у .env та вкажіть власні налаштування при необхідності.
# Усі змінні конфігурації бекенду мають префікс MIAUTO_

# Основні параметри програми
MIAUTO_APP_NAME=MIAUTO
MIAUTO_APP_VERSION=1.0.0

# Мережеві налаштування бекенду
MIAUTO_HOST=127.0.0.1
MIAUTO_PORT=8421

# База даних SQLite
# Якщо не вказано, використовується backend/data/miauto.db (або %APPDATA%/MIAUTO/data для exe)
MIAUTO_DB_NAME=miauto.db

# Зовнішні сервіси та API
MIAUTO_MONOBANK_API_URL=https://api.monobank.ua/bank/currency
MIAUTO_CURRENCY_CACHE_TTL=300
